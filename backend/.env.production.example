# Production Environment Configuration Template
FRONTEND_URL=https://app.solvane.io
BACKEND_URL=https://api.solvane.io
ALLOWED_ORIGINS=https://app.solvane.io,https://solvane.io

# OAuth GitHub Production Credentials
GITHUB_CLIENT_ID=your_prod_github_client_id
GITHUB_CLIENT_SECRET=your_prod_github_client_secret
GITHUB_CALLBACK_URL=https://api.solvane.io/api/auth/oauth/github/callback

# OAuth Google Production Credentials
GOOGLE_CLIENT_ID=your_prod_google_client_id
GOOGLE_CLIENT_SECRET=your_prod_google_client_secret
GOOGLE_CALLBACK_URL=https://api.solvane.io/api/auth/oauth/google/callback

# Email & Resend Production Service
RESEND_API_KEY=re_prod_your_resend_api_key
EMAIL_FROM=security@solvane.io

# Database & Security
DATABASE_URL=postgresql://solvane_prod:secure_password_here@db.production.internal:5432/solvane_prod_db
JWT_SECRET=production-high-entropy-jwt-signing-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFY_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
